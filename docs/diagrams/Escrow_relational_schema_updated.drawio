      <mxCell id="N953" value="&lt;font style=&quot;font-size:11px&quot;&gt;email UNIQUE + format CHECK&lt;br&gt;role ∈ {BUYER, SELLER, ARBITRATOR, ADMIN}&lt;br&gt;password_hash = salted scrypt hash (never plain text)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFFE0;strokeColor=#999999;spacing=4;dashed=1;" parent="1" vertex="1"><mxGeometry x="900" y="6.0" width="470" height="88" as="geometry" /></mxCell><mxCell id="N954" value="&lt;font style=&quot;font-size:11px&quot;&gt;buyer_id, seller_id → users.user_id&lt;br&gt;rule_id → multisig_rules.rule_id&lt;br&gt;CHECK amount &amp;gt; 0 ; CHECK buyer_id &amp;lt;&amp;gt; seller_id&lt;br&gt;status ∈ {PENDING, APPROVED, RELEASED, REFUNDED, DISPUTED, EXPIRED}&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFFE0;strokeColor=#999999;spacing=4;dashed=1;" parent="1" vertex="1"><mxGeometry x="900" y="156.0" width="470" height="88" as="geometry" /></mxCell><mxCell id="N955" value="&lt;font style=&quot;font-size:11px&quot;&gt;CHECK required_signatures &amp;gt; 0&lt;br&gt;CHECK required_signatures &amp;lt;= total_signers&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFFE0;strokeColor=#999999;spacing=4;dashed=1;" parent="1" vertex="1"><mxGeometry x="900" y="286.0" width="470" height="88" as="geometry" /></mxCell><mxCell id="N956" value="&lt;font style=&quot;font-size:11px&quot;&gt;escrow_id → escrows (ON DELETE CASCADE) ; user_id → users&lt;br&gt;UNIQUE (escrow_id, user_id)&lt;br&gt;signer_role ∈ {BUYER, SELLER, ARBITRATOR}&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFFE0;strokeColor=#999999;spacing=4;dashed=1;" parent="1" vertex="1"><mxGeometry x="900" y="416.0" width="470" height="88" as="geometry" /></mxCell><mxCell id="N957" value="&lt;font style=&quot;font-size:11px&quot;&gt;COMPOSITE FK (escrow_id, user_id) → escrow_signers(escrow_id, user_id)&lt;br&gt;UNIQUE (escrow_id, user_id) : one decision per signer&lt;br&gt;decision ∈ {APPROVE, REJECT}&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFFE0;strokeColor=#999999;spacing=4;dashed=1;" parent="1" vertex="1"><mxGeometry x="900" y="536.0" width="470" height="88" as="geometry" /></mxCell><mxCell id="N958" value="&lt;font style=&quot;font-size:11px&quot;&gt;escrow_id → escrows.escrow_id&lt;br&gt;type ∈ {DEPOSIT, RELEASE, REFUND}&lt;br&gt;status ∈ {PENDING, COMPLETED, FAILED} ; CHECK amount &amp;gt; 0&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFFE0;strokeColor=#999999;spacing=4;dashed=1;" parent="1" vertex="1"><mxGeometry x="900" y="656.0" width="470" height="88" as="geometry" /></mxCell><mxCell id="N959" value="&lt;font style=&quot;font-size:11px&quot;&gt;escrow_id → escrows ; raised_by → users&lt;br&gt;resolved_by → users (NULL until resolved)&lt;br&gt;status ∈ {OPEN, RESOLVED, REJECTED} ; FULLTEXT(reason)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFFE0;strokeColor=#999999;spacing=4;dashed=1;" parent="1" vertex="1"><mxGeometry x="900" y="786.0" width="470" height="88" as="geometry" /></mxCell><mxCell id="N960" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;underlined bold&lt;/b&gt;&lt;/u&gt; = Primary Key &amp;nbsp;|&amp;nbsp; &lt;i&gt;italic&lt;/i&gt; = Foreign Key&lt;br&gt;PK = primary key, FK = foreign key, UQ = unique, AI = auto-increment&lt;br&gt;Grey italic row = MySQL 8 data type &amp;nbsp;|&amp;nbsp; Arrow: parent table → child table (FK)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#000000;spacing=4;fontSize=11;" parent="1" vertex="1"><mxGeometry x="900" y="-60" width="470" height="66" as="geometry" /></mxCell><mxCell id="N961" value="user_id" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="DWBAEEMX1QCqZwGUBx4U-29" target="DWBAEEMX1QCqZwGUBx4U-68"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="N962" value="raised_by / resolved_by" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="DWBAEEMX1QCqZwGUBx4U-29" target="DWBAEEMX1QCqZwGUBx4U-94"><mxGeometry relative="1" as="geometry" /></mxCell></root>
    </mxGraphModel>
